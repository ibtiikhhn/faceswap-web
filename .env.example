# Copy to .env.local. Leave optional services commented until configured.
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=your-generated-secret-at-least-32-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PAYLOAD_SECRET=another-generated-secret-at-least-32-characters
# PAYLOAD_ADMIN_EMAIL=
# PAYLOAD_ADMIN_PASSWORD=

# Development fixture output only. APP_ENV=production rejects this.
SWAPS_ENABLED=true
SWAP_PROVIDER=mock
MOCK_SWAP_ENABLED=true
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
WORKER_POLL_MS=5000

# Legacy Stripe settings below are inactive. Do not configure for production.
# Paddle billing will be integrated separately.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEEKLY_PRICE_ID=
# BILLING_WEEKLY_CREDITS=
# STRIPE_MONTHLY_PRICE_ID=
# BILLING_MONTHLY_CREDITS=
# STRIPE_YEARLY_PRICE_ID=
# BILLING_YEARLY_CREDITS=
# STRIPE_CREDIT_PACK_PRICE_ID=
# BILLING_PACK_SMALL_CREDITS=
# STRIPE_PRICE_PACK_MEDIUM=
# BILLING_PACK_MEDIUM_CREDITS=
# STRIPE_PRICE_PACK_LARGE=
# BILLING_PACK_LARGE_CREDITS=

# Production photos: separate private uploads and public CMS media buckets.
# STORAGE_DRIVER=r2
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_URL=https://media.your-domain.com

# Keep combined web/worker/CMS pools within your database connection quota.
DATABASE_POOL_MAX=4
# CMS requires at least 4; lower values are raised to 4 by the application.
CMS_DATABASE_POOL_MAX=4
QUEUE_DATABASE_POOL_MAX=4

# Custom Swap: set SWAP_PROVIDER=external on BOTH web and worker to enable.
# No API key is specified in the supplied provider contract.
CUSTOM_SWAP_URL=https://faceswap-django.onrender.com/faceswap_file/
# Comma-separated exact HTTPS image hostnames (including redirect hosts).
# Obtain these from a successful provider response. No wildcard or URL paths.
CUSTOM_SWAP_RESULT_HOSTS=img.theapi.app

# Paddle: configure sandbox first, then separate live credentials/catalog for launch.
PADDLE_ENVIRONMENT=sandbox
PADDLE_BILLING_ENABLED=false
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEEKLY_PRICE_ID=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_PACK_200_PRICE_ID=
PADDLE_PACK_1000_PRICE_ID=

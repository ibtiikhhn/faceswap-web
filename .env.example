# Copy to .env.local. Leave optional services commented until configured.
APP_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=5

# Generate independent secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=your-generated-secret-at-least-32-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PAYLOAD_SECRET=another-generated-secret-at-least-32-characters
# PAYLOAD_ADMIN_EMAIL=
# PAYLOAD_ADMIN_PASSWORD=

# Development fixture output only. APP_ENV=production rejects this.
SWAP_PROVIDER=mock
MOCK_SWAP_ENABLED=true
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
WORKER_POLL_MS=5000

# Stripe: configure real credit counts only once prices are decided.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEEKLY_PRICE_ID=
# BILLING_WEEKLY_CREDITS=
# STRIPE_MONTHLY_PRICE_ID=
# BILLING_MONTHLY_CREDITS=
# STRIPE_YEARLY_PRICE_ID=
# BILLING_YEARLY_CREDITS=
# STRIPE_CREDIT_PACK_PRICE_ID=
# BILLING_PACK_SMALL_CREDITS=
# STRIPE_PRICE_PACK_MEDIUM=
# BILLING_PACK_MEDIUM_CREDITS=
# STRIPE_PRICE_PACK_LARGE=
# BILLING_PACK_LARGE_CREDITS=

# Production photos: separate private uploads and public CMS media buckets.
# STORAGE_DRIVER=r2
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_URL=https://media.your-domain.com

# Keep combined web/worker/CMS pools within your database connection quota.
DATABASE_POOL_MAX=4
CMS_DATABASE_POOL_MAX=4
QUEUE_DATABASE_POOL_MAX=4

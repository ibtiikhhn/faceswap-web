{
  "name": "faceswap-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "release": "node --env-file-if-exists=.env.local --import tsx scripts/release.ts",
    "cms:generate-types": "payload generate:types",
    "cms:generate-importmap": "payload generate:importmap",
    "cms:migrate": "node --env-file-if-exists=.env.local node_modules/payload/bin.js migrate",
    "cms:seed-admin": "node --env-file-if-exists=.env.local --import tsx scripts/seed-admin.ts",
    "db:dev": "node --import tsx scripts/dev-db.ts",
    "test:smoke": "node --import tsx scripts/smoke-api.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "@payloadcms/storage-s3": "^3.89.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "payload": "^3.89.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
